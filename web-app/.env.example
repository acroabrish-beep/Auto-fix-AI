VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your-project-id
VITE_APPWRITE_DATABASE_ID=your-database-id
VITE_APPWRITE_COLLECTION_ID=chat_history

# Server-side only: set this in the Appwrite Function `diagnostic-ai` environment.
# Never expose this in the browser or frontend code.
GEMINI_API_KEY=your-gemini-key

# Server-side only: used by setup-db.js / seed-learning.js.
# Never expose this in the browser or frontend code.
APPWRITE_API_KEY=your-server-api-key


# Department Admin Function
VITE_APPWRITE_DEPARTMENT_FUNCTION_ID=

# Admin Function
VITE_APPWRITE_ADMIN_FUNCTION_ID=

# Diagnostic AI Function (existing)
VITE_APPWRITE_DIAGNOSTIC_FUNCTION_ID=6a7743a8001a7c995501

# Important:
# - Department and admin Function IDs must be populated with their own actual deployed Function IDs.
# - The diagnostic ID belongs exclusively to diagnostic-ai.
# - No API keys, JWTs, or secrets belong in VITE_ variables.

